# Project release gates consumed by the AIWG flow-release skill.
version: 1

project:
  name: matric-eval
  display_name: matric-eval
  repo_url: https://git.integrolabs.net/roctinam/matric-eval
  mirror_url: https://github.com/jmagly/matric-eval

version_policy:
  format: calver
  pattern: YYYY.M.PATCH
  tag_prefix: v
  channels:
    stable:
      tag_format: "v{YYYY}.{M}.{PATCH}"
      require_announcement: false
      require_changelog: true
      require_uat: true

gates:
  - name: local-build-test
    hard_stop: true
    steps:
      - id: verify-version
        run: python3 scripts/release_contract.py versions --expected {version}
        expect_exit: 0
      - id: sync-locked-environment
        run: UV_PYTHON=3.11 uv sync --locked --extra dev --extra study
        expect_exit: 0
      - id: python-quality-and-tests
        run: UV_PYTHON=3.11 make ci
        expect_exit: 0
      - id: build-python-packages
        run: UV_PYTHON=3.11 uv build
        expect_exit: 0
      - id: install-typescript-dependencies
        run: npm ci --prefix bindings/typescript
        expect_exit: 0
      - id: build-typescript-package
        run: npm run build --prefix bindings/typescript
        expect_exit: 0
      - id: test-typescript-package
        run: npm test --prefix bindings/typescript
        expect_exit: 0
      - id: inspect-typescript-package
        run: npm pack --dry-run ./bindings/typescript
        expect_exit: 0

  - name: ci-green
    hard_stop: true
    tracker: gitea
    owner: roctinam
    repo: matric-eval
    timeout_seconds: 1200
    poll_interval_seconds: 30
    required_workflows: [ci.yml]

  - name: changelog-and-release-notes
    hard_stop: true
    required_for_channels: [stable]
    artifacts:
      - path: CHANGELOG.md
        section_pattern: '^## \[{version}\]'
        must_exist: true
      - path: "docs/releases/{version}.md"
        must_exist: true

  - name: readme-freshness
    hard_stop: false
    required_for_channels: [stable]
    review_diff:
      path: README.md
      since_tag: latest-stable
      prompt: "Does README.md accurately describe the user-visible behavior in this release?"

  - name: release
    hard_stop: true
    steps:
      - id: verify-tag-preconditions
        run: tools/release/cut-tag.sh {version} --check
        expect_exit: 0
      - id: cut-checked-tag
        run: tools/release/cut-tag.sh {version}
        expect_exit: 0
      - id: push-gitea-tag
        run: git push origin refs/tags/{tag}
        expect_exit: 0
      - id: sync-github-main
        run: git push github refs/remotes/origin/main:refs/heads/main
        expect_exit: 0
      - id: push-github-tag
        run: git push github refs/tags/{tag}
        expect_exit: 0

  - name: gitea-release-workflow
    hard_stop: true
    tracker: gitea
    owner: roctinam
    repo: matric-eval
    timeout_seconds: 3600
    poll_interval_seconds: 30
    required_workflows: [release.yml]

  - name: github-release-workflow
    hard_stop: true
    tracker: github
    owner: jmagly
    repo: matric-eval
    timeout_seconds: 3600
    poll_interval_seconds: 30
    required_workflows: [release.yml]

policy:
  no_ai_attribution: true
  ci_green_before_done: true
  preserve_pre_release_announcements: false
  thank_external_reporters: true

publication_verify:
  release_assets:
    - SHA256SUMS
    - release-manifest.json
    - "matric_eval-{version}-py3-none-any.whl"
    - "matric_eval-{version}.tar.gz"
    - "matric-eval-client-{version}.tgz"
    - "matric-eval-{version}-release-bundle.tar.gz"
  checksums:
    manifest: SHA256SUMS
    must_cover:
      - release-manifest.json
      - "matric_eval-{version}-py3-none-any.whl"
      - "matric_eval-{version}.tar.gz"
      - "matric-eval-client-{version}.tgz"
