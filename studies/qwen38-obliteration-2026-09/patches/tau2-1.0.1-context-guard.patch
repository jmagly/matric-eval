diff --git a/src/tau2/utils/llm_utils.py b/src/tau2/utils/llm_utils.py
index cc70482..e2353ef 100644
--- a/src/tau2/utils/llm_utils.py
+++ b/src/tau2/utils/llm_utils.py
@@ -5,6 +5,8 @@ import re
 import time
 import uuid
 import warnings
+from collections.abc import Callable, Iterator
+from contextlib import contextmanager
 from contextvars import ContextVar
 from datetime import datetime
 from pathlib import Path
@@ -59,6 +61,18 @@ llm_log_dir: ContextVar[Optional[Path]] = ContextVar("llm_log_dir", default=None
 # Context variable to store the LLM logging mode ("all" or "latest")
 llm_log_mode: ContextVar[str] = ContextVar("llm_log_mode", default="latest")
 
+LLMRequestGuard = Callable[
+    [str, list[dict], Optional[list[dict]], Optional[str], Optional[str], dict[str, Any]],
+    None,
+]
+
+# A per-execution-context hook for validating the exact LiteLLM request assembled
+# by generate(). The default preserves upstream behavior. Study runners can scope
+# a guard around one target trajectory without affecting simulator/evaluator calls.
+llm_request_guard: ContextVar[Optional[LLMRequestGuard]] = ContextVar(
+    "llm_request_guard", default=None
+)
+
 # litellm._turn_on_debug()
 
 logging.getLogger("LiteLLM").setLevel(logging.WARNING)
@@ -267,6 +281,16 @@ def set_llm_log_mode(mode: str) -> None:
     llm_log_mode.set(mode)
 
 
+@contextmanager
+def scoped_llm_request_guard(guard: LLMRequestGuard) -> Iterator[None]:
+    """Install a request guard for the current execution context only."""
+    token = llm_request_guard.set(guard)
+    try:
+        yield
+    finally:
+        llm_request_guard.reset(token)
+
+
 def _format_messages_for_logging(messages: list[dict]) -> list[dict]:
     """
     Format messages for debug logging by splitting content on newlines.
@@ -390,6 +414,17 @@ def generate(
     if tools_schema and tool_choice is None:
         tool_choice = "auto"
 
+    guard = llm_request_guard.get()
+    if guard is not None:
+        guard(
+            model,
+            litellm_messages,
+            tools_schema,
+            tool_choice,
+            call_name,
+            dict(kwargs),
+        )
+
     # Prepare request data for logging
     formatted_messages = _format_messages_for_logging(litellm_messages)
     request_data = {
