+class TauRuntimeInvalid(RuntimeError):
+    """Typed failure that must be excluded from capability scoring."""
+
+    def __init__(self, evidence: dict[str, Any], message: str):
+        self.evidence = dict(evidence)
+        super().__init__(message)
+
+
+class LLMBoundaryRuntimeInvalid(TauRuntimeInvalid):
+    """Sampling, transport, or response-decoding failure at one LLM boundary."""
+
+
+class SimulatorOutputRuntimeInvalid(TauRuntimeInvalid):
+    """Invalid user-simulator output rejected before constructing a UserMessage."""
+
+
+@dataclass
+class SimulationRuntimeEvidence:
+    """Content-free counters scoped to exactly one simulation attempt."""
+
+    environment_call_count: int = 0
+    simulator_sampling_attempts: int = 0
+    simulator_recovery_attempts: int = 0
+    side_effect_retry_attempted: bool = False
+    failures: list[dict[str, Any]] = field(default_factory=list)
+
+    def as_dict(self) -> dict[str, Any]:
+        """Return stable evidence without prompts, completions, or tool arguments."""
+        return {
+            "environment_call_count": self.environment_call_count,
+            "simulator_sampling_attempts": self.simulator_sampling_attempts,
+            "simulator_recovery_attempts": self.simulator_recovery_attempts,
+            "side_effect_retry_attempted": self.side_effect_retry_attempted,
+            "failures": [dict(item) for item in self.failures],
+        }
+
+
+simulation_runtime_evidence: ContextVar[Optional[SimulationRuntimeEvidence]] = (
+    ContextVar("simulation_runtime_evidence", default=None)
+)
