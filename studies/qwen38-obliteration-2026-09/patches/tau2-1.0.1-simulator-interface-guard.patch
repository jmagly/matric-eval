+@contextmanager
+def scoped_simulation_runtime_evidence() -> Iterator[SimulationRuntimeEvidence]:
+    """Scope side-effect and simulator-recovery evidence to one trajectory."""
+    evidence = SimulationRuntimeEvidence()
+    token = simulation_runtime_evidence.set(evidence)
+    try:
+        yield evidence
+    finally:
+        simulation_runtime_evidence.reset(token)
+
+
+def mark_environment_call() -> None:
+    """Mark the boundary immediately before an environment tool execution."""
+    evidence = simulation_runtime_evidence.get()
+    if evidence is not None:
+        evidence.environment_call_count += 1
+
+
+def simulator_recovery_allowed() -> bool:
+    """Return whether the study scope can safely replay a simulator sample."""
+    evidence = simulation_runtime_evidence.get()
+    return evidence is not None and evidence.environment_call_count == 0
+
+
+def record_simulator_attempt() -> None:
+    """Record one simulator HTTP sampling attempt in the current study scope."""
+    evidence = simulation_runtime_evidence.get()
+    if evidence is not None:
+        evidence.simulator_sampling_attempts += 1
+
+
+def record_simulator_recovery() -> None:
+    """Record the one bounded, pre-side-effect simulator recovery."""
+    evidence = simulation_runtime_evidence.get()
+    if evidence is not None:
+        evidence.simulator_recovery_attempts += 1
+
+
+def record_runtime_failure(failure: dict[str, Any]) -> None:
+    """Retain only typed, content-free failure metadata in the current scope."""
+    evidence = simulation_runtime_evidence.get()
+    if evidence is not None:
+        evidence.failures.append(dict(failure))
+
+
+def _sampling_boundary(call_name: Optional[str]) -> tuple[str, str]:
+    if call_name == "agent_response":
+        return "target-model", "target-sampling"
+    if call_name == "user_simulator_response":
+        return "user-simulator", "simulator-sampling"
+    if call_name == "nl_assertions_eval":
+        return "evaluator", "nl-evaluation"
+    return "harness-interface", "llm-sampling"
+
+
+def _transport_failure_reason(exc: BaseException) -> str:
+    """Classify response-shape failures without retaining response content."""
+    fragments: list[str] = []
+    current: BaseException | None = exc
+    seen: set[int] = set()
+    json_decode = False
+    empty_body = False
+    while current is not None and id(current) not in seen and len(seen) < 8:
+        seen.add(id(current))
+        fragments.extend((type(current).__name__, str(current)))
+        json_decode = json_decode or isinstance(current, json.JSONDecodeError)
+        response = getattr(current, "response", None)
+        if response is not None:
+            body = getattr(response, "text", getattr(response, "content", None))
+            if body is not None:
+                body_text = (
+                    body.decode(errors="replace")
+                    if isinstance(body, bytes)
+                    else str(body)
+                )
+                fragments.append(body_text)
+                empty_body = empty_body or not body_text.strip()
+            headers = getattr(response, "headers", None)
+            if headers is not None:
+                get_header = getattr(headers, "get", None)
+                if callable(get_header):
+                    fragments.append(str(get_header("content-type", "")))
+        current = current.__cause__ or current.__context__
+    normalized = " ".join(fragments).strip().lower()
+    json_position = re.search(r"column\s+(\d+)\s+\(char\s+(\d+)\)", normalized)
+    nonempty_json_prefix = json_position is not None and (
+        int(json_position.group(1)) > 1 or int(json_position.group(2)) > 0
+    )
+    if (
+        "text/html" in normalized
+        or "<!doctype html" in normalized
+        or "<html" in normalized
+    ):
+        return "html_response_body"
+    if nonempty_json_prefix:
+        return "truncated_json_response"
+    if empty_body or any(
+        marker in normalized
+        for marker in ("empty response", "empty body", "no response body")
+    ):
+        return "empty_response_body"
+    if json_decode or any(
+        marker in normalized
+        for marker in (
+            "jsondecode",
+            "json decode",
+            "expecting value",
+            "unterminated",
+            "unexpected eof",
+        )
+    ):
+        return "truncated_json_response"
+    if not normalized:
+        return "empty_response_body"
+    return "sampling_failure"
+
+
+def _boundary_invalid(
+    *,
+    call_name: Optional[str],
+    reason: str,
+    http_attempted: bool,
+    message: str,
+) -> LLMBoundaryRuntimeInvalid:
+    actor, stage = _sampling_boundary(call_name)
+    failure = {
+        "actor": actor,
+        "stage": stage,
+        "reason": reason,
+        "http_attempted": http_attempted,
+        "retryable": actor == "user-simulator",
+        "side_effect_retry_attempted": False,
+    }
+    record_runtime_failure(failure)
+    return LLMBoundaryRuntimeInvalid(failure, message)
+
