+++ b/src/harbor/llms/base.py
@@ -51,6 +51,30 @@ class OutputLengthExceededError(Exception):
         self.truncated_response = truncated_response
 
 
+class LLMResponseTimeoutError(Exception):
+    """Raised when one model response exceeds its configured transport timeout."""
+
+
+class ContextPreflightError(Exception):
+    """Raised when the first serialized agent request cannot fit the context."""
+
+
+class ContextRecoveryExhaustedError(Exception):
+    """Raised when the single bounded context recovery does not fit."""
+
+
+class OutputRecoveryExhaustedError(Exception):
+    """Raised when the single bounded output/parse recovery does not succeed."""
+
+
+class CommandTimeoutError(Exception):
+    """Raised when a terminal command times out and cannot safely be retried."""
+
+
+class AgentNoSubmitError(Exception):
+    """Raised when the agent terminates or exhausts turns without submission."""
+
+
 class BaseLLM(ABC):
