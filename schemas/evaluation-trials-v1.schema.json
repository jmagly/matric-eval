            {
              "type": "null"
            }
          ],
          "title": "Sha256"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unavailable Reason"
        }
      },
      "required": [
        "uri",
        "sha256",
        "unavailable_reason"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
