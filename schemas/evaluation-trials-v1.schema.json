          "const": "unverified",
          "title": "Independence",
          "type": "string"
        },
        "statistical_claim": {
          "const": "descriptive_only",
          "default": "descriptive_only",
          "title": "Statistical Claim",
          "type": "string"
        }
      },
      "required": [
        "version",
        "n",
        "k",
        "metric_id",
        "metric_version",
        "predicate",
        "generation_seeds",
        "root_generation_seed",
        "selection_seed",
        "task_content_sha256",
        "independence"
      ],
      "title": "TrialProtocol",
      "type": "object"
    },
    "TrialRecord": {
      "additionalProperties": false,
      "properties": {
        "trial_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Trial Id",
          "type": "string"
        },
        "generation_seed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Generation Seed",
          "type": "integer"
        },
        "benchmark": {
          "anyOf": [
            {
              "$ref": "#/$defs/BenchmarkResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unavailable Reason"
        },
        "native_trial_id": {
          "default": "epoch-1",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Native Trial Id",
          "type": "string"
        },
        "generation_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenerationEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "failure_code": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        }
      },
      "required": [
        "trial_id",
        "generation_seed",
        "benchmark",
        "unavailable_reason"
      ],
      "title": "TrialRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "trial_schema_version": {
      "const": "1",
      "title": "Trial Schema Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Run Id",
      "type": "string"
    },
    "model_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Model Id",
      "type": "string"
    },
    "benchmark_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Benchmark Id",
      "type": "string"
    },
    "protocol": {
      "$ref": "#/$defs/TrialProtocol"
    },
    "manifest": {
      "items": {
        "$ref": "#/$defs/Selection"
      },
      "title": "Manifest",
      "type": "array"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "trials": {
      "items": {
        "$ref": "#/$defs/TrialRecord"
      },
      "title": "Trials",
      "type": "array"
    },
    "per_task": {
      "items": {
        "$ref": "#/$defs/PerTaskResult"
      },
      "title": "Per Task",
      "type": "array"
    },
    "macro_pass_at_k": {
      "$ref": "#/$defs/Estimate"
    },
    "macro_all_n_success": {
      "$ref": "#/$defs/Estimate"
    },
    "execution": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ],
      "title": "Execution",
      "type": "string"
    },
    "eligibility": {
      "$ref": "#/$defs/Eligibility"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "trial_schema_version",
    "run_id",
    "model_id",
    "benchmark_id",
    "protocol",
    "manifest",
    "manifest_sha256",
    "trials",
    "per_task",
    "macro_pass_at_k",
    "macro_all_n_success",
    "execution",
    "eligibility",
    "limitations"
  ],
  "title": "TrialEvaluation",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matric.dev/schemas/evaluation-trials-v1.schema.json"
}
